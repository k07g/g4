PORT=8080

# AWS Cognito
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only required if the Cognito app client is configured with a client secret
COGNITO_CLIENT_SECRET=

# PostgreSQL (application-level user profile data, separate from Cognito credentials)
DATABASE_URL=postgres://user:password@localhost:5432/g4?sslmode=disable
