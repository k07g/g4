# Local development: AWS Cognito 不要の設定例。
# `cp .env.local.example .env.local && set -a && source .env.local && set +a`
# のように読み込んでから `go run ./cmd/server` を実行してください。

PORT=8080

# インメモリ認証プロバイダ(AWSアカウント不要)。本番では使用しないこと。
AUTH_PROVIDER=memory

# docker compose up -d postgres で起動したローカルDB (ホスト側ポートは5433)
DATABASE_URL=postgres://g4:g4@localhost:5433/g4?sslmode=disable
